{
  "name": "llama-pro",
  "version": "2.0.1",
  "description": "LLaMA Pro Desktop Wrapper",
  "repository": "https://github.com/example/llama-pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.llama.pro",
    "productName": "LLaMA Pro",
    "win": {
      "target": "dir"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "build/icon.ico",
      {
        "from": "../ui/dist",
        "to": "ui-dist"
      }
    ]
  }
}
